<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Title>An Application layer specific for trading.</Title>
    <Description>Common abstractions (Strategy, Portfolio, BackTest) specific to a Trading Application layer.</Description>
    <PackageTags>CleanArchitecture;Domain;Entities;Shared;ApplicationLayer;SecurityMaster;TradingStrategy;Portfolio;BackTesting</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <!-- RS0026 fires on pre-release overloads with optional params; nothing is shipped, backcompat rule not applicable -->
    <NoWarn>$(NoWarn);RS0026</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\Resources\icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include=".\doc\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Boutquin.MarketData.Abstractions" />
    <PackageReference Include="Boutquin.Numerics" />
    <PackageReference Include="Boutquin.MarketData.Calendars" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="MinVer" PrivateAssets="All" />
    <PackageReference Include="System.Linq.Async" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Domain\Boutquin.Trading.Domain.csproj" />
    <ProjectReference Include="..\Recipes\Boutquin.Trading.Recipes.csproj" />
  </ItemGroup>

</Project>
